{
  "name": "nest-schematics",
  "version": "0.1.1",
  "description": "NestJS + TypeORM monorepo starter and lego-style generators (CRUD, auth, upload, payments, notifications, AI, logs), compatible with fuse-schematics (Angular)",
  "main": "src/collection.json",
  "schematics": "./src/collection.json",
  "bin": {
    "nest-schematics": "bin/nest-schematics.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && jasmine \"src/**/*_spec.js\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nestjs",
    "nest",
    "schematics",
    "nestjs-schematics",
    "typeorm",
    "postgresql",
    "crud",
    "crud-generator",
    "generator",
    "code-generator",
    "scaffolding",
    "admin-api",
    "primeng",
    "swagger",
    "fuse-schematics",
    "generator-cli"
  ],
  "author": {
    "name": "Islom Karimov",
    "email": "islomkarimovalisherovich@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "peerDependencies": {
    "@nestjs/core": "^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@angular-devkit/core": "^20.3.9",
    "@angular-devkit/schematics": "^20.3.9",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine": "^5.0.0"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*_spec.*",
    "!src/**/*.js.map",
    "!src/utils/ops/testing",
    "!src/testing",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Islom1999/nest-schematics.git"
  },
  "bugs": {
    "url": "https://github.com/Islom1999/nest-schematics/issues"
  },
  "homepage": "https://github.com/Islom1999/nest-schematics#readme",
  "publishConfig": {
    "access": "public"
  }
}
