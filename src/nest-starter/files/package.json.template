{
  "name": "<%= dasherize(name) %>",
  "version": "0.0.1",
  "description": "NestJS + TypeORM (PostgreSQL) monorepo: <%= apps.join(', ') %>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "<%= apps.map((a) => 'nest build ' + a).join(' && ') %>",<% for (const app of apps) { %>
    "build:<%= app %>": "nest build <%= app %>",
    "start:dev:<%= app %>": "nest start <%= app %> --watch",
    "start:prod:<%= app %>": "node dist/apps/<%= app %>/main",<% } %>
    "start:dev": "nest start api --watch",
    "typeorm": "typeorm-ts-node-commonjs -r tsconfig-paths/register -d libs/database/src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate libs/database/src/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",<% if (apps.includes('worker')) { %>
    "@nestjs/schedule": "^6.0.0",<% } %>
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",<% if (apps.includes('bot')) { %>
    "telegraf": "^4.16.3",<% } %>
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2"
  }
}
