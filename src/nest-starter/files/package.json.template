{
  "name": "<%= dasherize(name) %>",
  "version": "0.0.1",
  "description": "NestJS + TypeORM (PostgreSQL) monorepo: <%= apps.join(', ') %>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "<%= apps.map((a) => 'nest build ' + a).join(' && ') %>",<% for (const app of apps) { %>
    "build:<%= app %>": "nest build <%= app %>",
    "start:dev:<%= app %>": "nest start <%= app %> --watch",
    "start:prod:<%= app %>": "node dist/apps/<%= app %>/main",<% } %>
    "start:dev": "nest start api --watch",
    "g": "nest-schematics",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "node tools/migration.js generate",
    "migration:create": "node tools/migration.js create",
    "migration:run": "npm run typeorm -- migration:run -d libs/database/src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d libs/database/src/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d libs/database/src/data-source.ts",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register libs/database/src/seed.ts",
    "swagger:export": "ts-node -T -r tsconfig-paths/register apps/api/src/config/swagger-export.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",<% if (apps.includes('worker')) { %>
    "@nestjs/schedule": "^6.0.0",<% } %>
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.0",
    "dotenv": "^16.4.7",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",<% if (apps.includes('bot')) { %>
    "telegraf": "^4.16.3",<% } %>
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/compression": "^1.8.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "jest": "^30.0.0",
    "nest-schematics": "^<%= version %>",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "{apps,libs}/**/*.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src$1"
    }
  }
}
