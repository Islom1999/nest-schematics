{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test/"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/libs/common/src$1",
    "^@app/database(|/.*)$": "<rootDir>/libs/database/src$1"
  }
}
