# ── App ──────────────────────────────────────────────
NODE_ENV=development
# apps/api HTTP port
PORT=3000
# Comma-separated list; empty = allow http://localhost:4200
CORS_ORIGINS=http://localhost:4200
# Reverse proxy hops (e.g. 1 behind nginx). Never "true". Rate limits use the
# client IP from X-Forwarded-For only when this is set.
TRUST_PROXY=
# Swagger (/docs, /docs/admin, /docs/client) is on outside production; set true/false to force it.
SWAGGER_ENABLED=
# Basic auth for /docs. Required to enable Swagger in production; optional elsewhere.
SWAGGER_USER=
SWAGGER_PASSWORD=

# ── Database (PostgreSQL) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=<%= underscore(name) %>
# Schema changes go through migrations. true is refused when NODE_ENV=production.
DB_SYNCHRONIZE=false
# Run pending migrations when an app boots (safe with several instances: advisory lock)
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# ── Rate limiting ────────────────────────────────────
# Global limit per client IP: THROTTLE_LIMIT requests per THROTTLE_TTL seconds
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Sign-in and other @AuthThrottle() routes: requests per minute per IP
AUTH_THROTTLE_LIMIT=5

# ── Admin auth ───────────────────────────────────────
# Two different random strings, 32+ chars each: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-access-secret-at-least-32-chars
ADMIN_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Access token lifetime (s, m, h, d); refresh token = session lifetime
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=30d
# Max signed-in devices per admin; the oldest session is ended beyond it
ADMIN_SESSION_LIMIT=10
# First super admin, created on start while the admins table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
<% if (apps.includes('bot')) { %>
# ── apps/bot (Telegram, telegraf) ────────────────────
# Empty = bot disabled
BOT_TOKEN=
<% } %>