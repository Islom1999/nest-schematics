# ── App ──────────────────────────────────────────────
NODE_ENV=development
# apps/api HTTP port
PORT=3000
# Comma-separated list; empty = allow http://localhost:4200
CORS_ORIGINS=http://localhost:4200
# Reverse proxy hops (e.g. 1 behind nginx). Never "true".
TRUST_PROXY=
# Swagger is on outside production; set true/false to force it.
SWAGGER_ENABLED=

# ── Database (PostgreSQL) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=<%= underscore(name) %>
# true only in local development; production uses migrations
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── Admin auth ───────────────────────────────────────
# Two different random strings, 32+ chars each: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-access-secret-at-least-32-chars
ADMIN_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Access token lifetime (s, m, h, d); refresh token = session lifetime
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=30d
# Max signed-in devices per admin; the oldest session is ended beyond it
ADMIN_SESSION_LIMIT=10
# First super admin, created on start while the admins table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
<% if (apps.includes('bot')) { %>
# ── apps/bot (Telegram, telegraf) ────────────────────
# Empty = bot disabled
BOT_TOKEN=
<% } %>