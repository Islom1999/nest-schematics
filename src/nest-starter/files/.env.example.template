# ── App ──────────────────────────────────────────────
NODE_ENV=development
# apps/api HTTP port
PORT=3000
# Comma-separated list; empty = allow http://localhost:4200
CORS_ORIGINS=http://localhost:4200
# Reverse proxy hops (e.g. 1 behind nginx). Never "true".
TRUST_PROXY=
# Swagger (/docs, /docs/admin, /docs/client) is on outside production; set true/false to force it.
SWAGGER_ENABLED=
# Basic auth for /docs. Required to enable Swagger in production; optional elsewhere.
SWAGGER_USER=
SWAGGER_PASSWORD=

# ── Database (PostgreSQL) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=<%= underscore(name) %>
# true only in local development; production uses migrations
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── Admin auth (skeleton) ────────────────────────────
# Long random string: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_JWT_EXPIRES_IN=1d
# Single env-based admin until you add an Admin entity
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
<% if (apps.includes('bot')) { %>
# ── apps/bot (Telegram, telegraf) ────────────────────
# Empty = bot disabled
BOT_TOKEN=
<% } %>