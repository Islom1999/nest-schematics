{
  "$schema": "http://json-schema.org/schema",
  "$id": "RedisAddonSchema",
  "title": "Redis (cache, session cache, rate limits)",
  "type": "object",
  "properties": {
    "force": {
      "type": "boolean",
      "description": "Overwrite generated files that you have edited",
      "default": false
    },
    "skipInstall": {
      "type": "boolean",
      "description": "Do not run npm install",
      "default": false
    },
    "root": {
      "type": "string",
      "description": "Project directory relative to the current directory (used by `new --apps`)",
      "default": ""
    }
  }
}
