{
  "$schema": "http://json-schema.org/schema",
  "$id": "SmsAddonSchema",
  "title": "SMS sending (SmsModule / SmsService)",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["eskiz", "log"],
      "description": "SMS gateway: eskiz (Eskiz.uz) or log (development: messages go to the server log)",
      "default": "eskiz",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "force": {
      "type": "boolean",
      "description": "Overwrite generated files that you have edited",
      "default": false
    },
    "skipInstall": {
      "type": "boolean",
      "description": "Do not run npm install",
      "default": false
    },
    "root": {
      "type": "string",
      "description": "Project directory relative to the current directory",
      "default": ""
    }
  }
}
