import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { BaseCrudService, <% if (serviceMembers.includes('RelationIds')) { %>RelationIds, <% } %>TableQueryOptions } from '@app/common';
import { <%= serviceEntityImports.join(', ') %> } from '@app/database';
import { Create<%= classify(name) %>Dto } from './dto/create-<%= dasherize(name) %>.dto';
import { Update<%= classify(name) %>Dto } from './dto/update-<%= dasherize(name) %>.dto';

@Injectable()
export class <%= classify(name) %>Service extends BaseCrudService<
  <%= classify(name) %>,
  Create<%= classify(name) %>Dto,
  Update<%= classify(name) %>Dto
> {
<%= serviceMembers %>
  protected override tableOptions: TableQueryOptions = {
    searchFields: [<%= searchFields.map((f) => "'" + f + "'").join(', ') %>],
<% if (serviceTableOptions) { %><%= serviceTableOptions %>
<% } %>    defaultSort: { field: 'createdAt', order: 'DESC' },
  };

  constructor(@InjectRepository(<%= classify(name) %>) repository: Repository<<%= classify(name) %>>) {
    super(repository);
  }
}
